# VektorSec deploy secrets template (DO NOT COMMIT real values)
# Copy this file to deploy/secrets.env and fill in the real passwords, then run
#   powershell -ExecutionPolicy Bypass -File deploy\deploy.ps1
#
# MONGO_PASSWORD / REDIS_PASSWORD are used by docker-compose.yml (which runs
# MongoDB with --auth and Redis with --requirepass). On a FRESH MongoDB volume
# the MONGO_USER/MONGO_PASSWORD pair also creates the root user. On an existing
# volume the user must already exist (create it once with mongosh admin).
#
# Generate values with: openssl rand -hex 24
MONGO_USER=root
MONGO_PASSWORD=change-me-strong-mongo-password
REDIS_PASSWORD=change-me-strong-redis-password
