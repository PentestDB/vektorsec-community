# ─── VektorSec — Dynamic Configuration template (backend/.env.example) ─────
# 1) Copy to backend/.env   ->   cp backend/.env.example backend/.env
# 2) Fill in YOUR values. This file is read + rewritten at runtime by the
#    backend API (Settings UI) and applied immediately without a restart.
#
# Docker Compose จะ mount backend/.env เข้าไปที่ /srv/data/.env ใน container
# (ดู docker-compose.yml) — ตัว backend อ่าน config.toml + .env จากที่นั่น
#
# ห้าม commit backend/.env จริง — commit เฉพาะไฟล์ .example นี้

# ── Admin Account (seeded automatically on startup if no admin exists) ──
# ถ้า ADMIN_EMAIL / ADMIN_PASSWORD ว่าง ตัว backend จะสร้าง admin อัตโนมัติด้วย
# อีเมล admin@vektorsec.local และสุ่มรหัสผ่านชั่วคราว แล้วพิมพ์ไว้ใน backend logs
# (docker logs vektorsec-backend-1) — เปลี่ยนรหัสทันทีหลัง login ครั้งแรก
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Telegram Bot ──
# Bot token จาก @BotFather (required เพื่อเปิดใช้งาน Telegram bot)
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram user IDs ที่ให้สิทธิ์ admin สำหรับทดสอบ
# เช่น TELEGRAM_ADMIN_IDS=123456789,987654321
TELEGRAM_ADMIN_IDS=

# ── Google Search (สำหรับ agent ที่ใช้ search) ──
GOOGLE-API-KEY=
CUSTOM-SEARCH-ENGINE-ID=

# ── SSH / Exploit Box ──
# ─── Out-of-Band (OOB) Listener ──
# Base URL ที่ OOB listener ใช้ฝังใน payload ที่สร้าง (เช่น https://<YOUR_DOMAIN>/api)
# ปล่อยว่าง = ใช้ relative path (agent จะเติม server URL เอง)
OOB_BASE_URL=

# ตัวอย่าง: SSH_HOST=<YOUR_EXPLOIT_BOX_IP_OR_HOST> (เช่น kali หรือ 10.0.0.5)
SSH_HOST=
SSH_PORT=22
SSH_USERNAME=root
SSH_PASSWORD=
SSH_PRIVATE_KEY=
SSH_PRIVATE_KEY_PASSPHRASE=

# ── Anthropic OAuth (เติมอัตโนมัติตอนเชื่อมบัญชี Claude) ──
ANTHROPIC_OAUTH_ACCESS_TOKEN=
ANTHROPIC_OAUTH_REFRESH_TOKEN=
ANTHROPIC_OAUTH_EXPIRES_AT=

# ── VNC / GUI (ตั้งค่าผ่าน Settings > GUI) ──
VNC_MODE=
VNC_HOST=
VNC_PORT=9020
VNC_PASSWORD=
VNC_SETUP_DONE=false
VNC_BASE_URL=
VNC_DISPLAY=:89
VNC_RFBPORT=5989
WEBSOCKIFY_PORT=9020

# ── Burp Suite Integration (ตั้งค่าผ่าน Settings > Burp) ──
BURP_RPC_HOST=
BURP_RPC_PORT=50051

# ── Caido Integration (ตั้งค่าผ่าน Settings > Caido) ──
CAIDO_URL=
CAIDO_PAT=
CAIDO_PROXY_URL=

# ── Mythic C2 Integration (ตั้งค่าผ่าน Settings > Mythic C2) ──
# URL ของ Mythic server เช่น https://10.0.0.5:7443
MYTHIC_URL=
# API token จาก Mythic UI (Operations > API Tokens) — ขึ้นต้นด้วย mtk_ บน Mythic 4.x
MYTHIC_API_TOKEN=
# Mythic ใช้ self-signed cert โดยค่าเริ่มต้น; set true เฉพาะเมื่อคาดว่าเป็นเช่นนั้น
MYTHIC_INSECURE_TLS=false

# ── Magnitude Browser Agent (ตั้งค่าผ่าน Settings > Browser Agent) ──
MAGNITUDE_ENABLED=false
MAGNITUDE_HEADLESS=false
MAGNITUDE_PROXY_URL=
MAGNITUDE_DISPLAY=:99

# ── AWS Bedrock (เพิ่ม API key ต่อ model ใน Settings > Models) ──
# Bedrock endpoint แยกตาม region — ตั้ง region ได้ที่นี่ (default us-east-1)
BEDROCK_REGION=

# ── MCP Safety ──
# 0 = บล็อกเครื่องมือที่ต้อง consent/อันตรายผ่าน MCP; เปิดจาก Settings > MCP Access เมื่อจำเป็น
PENTEST_MCP_ALLOW_DANGEROUS=0
PENTEST_MCP_MAX_OUTPUT_CHARS=60000

# ── Google reCAPTCHA (ป้องกัน login/register) ──
# เอา key จาก https://www.google.com/recaptcha/admin (v2 Checkbox หรือ v3)
# ปล่อยว่างทั้งคู่ = ปิด reCAPTCHA
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# Minimum score สำหรับ reCAPTCHA v3 (0.0 - 1.0, default 0.5)
RECAPTCHA_MIN_SCORE=0.5

# ── Google OAuth (Continue with Google) ──
# สร้าง OAuth 2.0 Client ID ใน Google Cloud Console (Authorized redirect URI:
# https://<YOUR_DOMAIN>/api/auth/google/callback หรือ http://localhost:8081/api/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── GitHub OAuth (Continue with GitHub) ──
# สร้าง OAuth App ใน GitHub Developer Settings (Authorized callback URL:
# https://<YOUR_DOMAIN>/api/auth/github/callback หรือ http://localhost:8081/api/auth/github/callback)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# URL ที่ redirect กลับหลัง OAuth เสร็จ (ตัวเว็บแอป)
# ตอน deploy บนโดเมนให้ใช้ FRONTEND_URL=https://<YOUR_DOMAIN>
FRONTEND_URL=http://localhost:3001

# Optional overrides (default: http://localhost:8081/api/auth/<provider>/callback)
# BACKEND_URI=http://localhost:8081
# GOOGLE_OAUTH_REDIRECT_URI=
# GITHUB_OAUTH_REDIRECT_URI=