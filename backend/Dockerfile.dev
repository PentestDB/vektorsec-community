# VektorSec backend — DEVELOPMENT image (hot reload)
#
# Runs the TypeScript source directly through tsx watch: editing a .ts file on
# the host restarts the backend process immediately (no tsc build step).
FROM node:22-bookworm-slim

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
ENV NODE_ENV=development

RUN corepack enable && corepack prepare pnpm@9.15.4 --activate

WORKDIR /app/backend

# Install dependencies first (better layer caching).
COPY package.json pnpm-lock.yaml* ./
RUN pnpm config set registry https://registry.npmjs.org && pnpm install

# Source is bind-mounted from the host (see docker-compose.dev.yml).
COPY . .

RUN mkdir -p /srv/data/workspaces

EXPOSE 8081

# tsx watch = hot reload on source changes.
CMD ["pnpm", "exec", "tsx", "watch", "src/server.ts"]
