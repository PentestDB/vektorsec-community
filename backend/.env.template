# ─── VektorSec — Dynamic Configuration ──────────────────────────
# This file is read and written at runtime by the backend API.
# Changes take effect immediately (no restart needed).
# Generated by run.sh — also editable via the Settings UI.

# ── Admin Account (seeded automatically on startup if no admin exists) ──
# If ADMIN_EMAIL / ADMIN_PASSWORD are empty, these defaults are used:
#   admin@vektorsec.local / admin1234
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Telegram Bot ──
# Bot token (required to enable the Telegram bot).
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram user IDs granted admin access for testing.

# e.g. TELEGRAM_ADMIN_IDS=123456789,987654321
# These users can use /admin commands without linking to a platform admin account.
TELEGRAM_ADMIN_IDS=

# ── Google Search ──
GOOGLE-API-KEY=
CUSTOM-SEARCH-ENGINE-ID=


# ── SSH / Exploit Box ──
# ─── Out-of-Band (OOB) Listener ──
# Base URL the OOB listener should advertise in generated payloads
# (e.g. https://vektorsec.example.com or http://localhost:8080).
# Leave empty to emit relative paths (the agent prefixes its own server URL).
OOB_BASE_URL=

SSH_HOST=
SSH_PORT=22
SSH_USERNAME=root
SSH_PASSWORD=
SSH_PRIVATE_KEY=
SSH_PRIVATE_KEY_PASSPHRASE=

# ── Anthropic OAuth (populated automatically when connecting Claude account) ──
ANTHROPIC_OAUTH_ACCESS_TOKEN=
ANTHROPIC_OAUTH_REFRESH_TOKEN=
ANTHROPIC_OAUTH_EXPIRES_AT=

# ── VNC / GUI (configurable via Settings > GUI) ──
VNC_MODE=
VNC_HOST=
VNC_PORT=9020
VNC_PASSWORD=
VNC_SETUP_DONE=false
VNC_BASE_URL=
VNC_DISPLAY=:89
VNC_RFBPORT=5989
WEBSOCKIFY_PORT=9020

# ── Burp Suite Integration (configurable via Settings > Burp) ──
BURP_RPC_HOST=
BURP_RPC_PORT=50051

# ── Caido Integration (configurable via Settings > Caido) ──
CAIDO_URL=
CAIDO_PAT=
CAIDO_PROXY_URL=

# ── Mythic C2 Integration (configurable via Settings > Mythic C2) ──
# URL of the operator's Mythic server, e.g. https://10.0.0.5:7443
MYTHIC_URL=
# API token from Mythic's UI (Operations > API Tokens). Starts with mtk_ on Mythic 4.x.
MYTHIC_API_TOKEN=
# Mythic ships a self-signed certificate by default; set true only if that is expected.
MYTHIC_INSECURE_TLS=false

# ── Magnitude Browser Agent (configurable via Settings > Browser Agent) ──
MAGNITUDE_ENABLED=false
MAGNITUDE_HEADLESS=false
MAGNITUDE_PROXY_URL=
MAGNITUDE_DISPLAY=:99

# ── AWS Bedrock (add the API key per-model in Settings > Models) ──
# Bedrock's endpoint is region-specific. This sets the region used when a model
# preset leaves Base URL blank; an explicit Base URL on the preset always wins.
# Defaults to us-east-1.
BEDROCK_REGION=

# ── MCP Safety ──
# 0 blocks consent-gated/destructive tools over MCP. Enable from Settings > MCP Access when needed.
PENTEST_MCP_ALLOW_DANGEROUS=0
PENTEST_MCP_MAX_OUTPUT_CHARS=60000

# ---- Google reCAPTCHA (login / register protection) ----
# Get keys at https://www.google.com/recaptcha/admin (v2 Checkbox or v3).
# Leave both keys empty to disable reCAPTCHA checks.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# Minimum accepted score for reCAPTCHA v3 (0.0 - 1.0, default 0.5).
RECAPTCHA_MIN_SCORE=0.5

# ---- Google OAuth (social login) ----
# Create an OAuth 2.0 Client ID in Google Cloud Console (Authorized redirect URI:
# http://localhost:8080/api/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- GitHub OAuth (social login) ----
# Create an OAuth App in GitHub Developer Settings (Authorized callback URL:
# http://localhost:8080/api/auth/github/callback)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Where the user is redirected after OAuth completes (the web app).
FRONTEND_URL=http://localhost:3000

# Optional overrides (defaults: http://localhost:8080/api/auth/<provider>/callback)
# BACKEND_URI=http://localhost:8080
# GOOGLE_OAUTH_REDIRECT_URI=
# GITHUB_OAUTH_REDIRECT_URI=

