# ─── Pentest Copilot — Dynamic Configuration ──────────────────────────
# This file is read and written at runtime by the backend API.
# Changes take effect immediately (no restart needed).
# Generated by run.sh — also editable via the Settings UI.

# ── Model configuration ──
# The main model is configured via ORCHESTRATOR_* variables (see below).

# ── Google Search ──
GOOGLE-API-KEY=
CUSTOM-SEARCH-ENGINE-ID=

# ── SSH / Exploit Box ──
SSH_HOST=
SSH_PORT=22
SSH_USERNAME=root
SSH_PASSWORD=
SSH_PRIVATE_KEY=
SSH_PRIVATE_KEY_PASSPHRASE=

# ── Anthropic OAuth (populated automatically when connecting Claude account) ──
ANTHROPIC_OAUTH_ACCESS_TOKEN=
ANTHROPIC_OAUTH_REFRESH_TOKEN=
ANTHROPIC_OAUTH_EXPIRES_AT=

# ── VNC / GUI (configurable via Settings > GUI) ──
VNC_MODE=
VNC_HOST=
VNC_PORT=9020
VNC_PASSWORD=
VNC_SETUP_DONE=false
VNC_BASE_URL=
VNC_DISPLAY=:89
VNC_RFBPORT=5989
WEBSOCKIFY_PORT=9020

# ── Burp Suite Integration (configurable via Settings > Burp) ──
BURP_RPC_HOST=
BURP_RPC_PORT=50051

# ── Magnitude Browser Agent (configurable via Settings > Browser Agent) ──
MAGNITUDE_ENABLED=false
MAGNITUDE_HEADLESS=false
MAGNITUDE_PROXY_URL=
MAGNITUDE_DISPLAY=:99
MAGNITUDE_MODEL_PROVIDER=
MAGNITUDE_MODEL=
MAGNITUDE_MODEL_API_KEY=
MAGNITUDE_MODEL_BASE_URL=

# ── Orchestrator (drives high-level planning and swarm coordination) ──
# Leave blank to use the main model as orchestrator.
ORCHESTRATOR_NAME=
ORCHESTRATOR_PROVIDER=
ORCHESTRATOR_MODEL=
ORCHESTRATOR_API_KEY=
ORCHESTRATOR_BASE_URL=
ORCHESTRATOR_REASONING_MODE=off

# ── Racers (parallel agents that compete on the same task, up to 8) ──
RACER_1_NAME=
RACER_1_PROVIDER=
RACER_1_MODEL=
RACER_1_API_KEY=
