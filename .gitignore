# ============================================================================
#  VektorSec — .gitignore (public repository)
#  ค่าลับ/ไฟล์ runtime ถูก ignore ทั้งหมด — ผู้ใช้ copy ไฟล์ *.example ไปเป็น
#  ชื่อจริง (config.toml, .env ฯลฯ) แล้วกรอกค่าของตัวเอง ห้าม commit ไฟล์จริง
# ============================================================================

# ── Secrets & runtime config (NEVER commit) ────────────────────────────────
config.toml
*.env
*.env.*
!.env.example
!.env.template
!deploy/secrets.env.example
backend/model-registry.json
*.pem
*.key
id_rsa
id_ed25519
# The DRM *public* verification key is not a secret: it ships with the app so a
# license can be verified offline. The matching private key never leaves the
# vendor, so only this public half is allowed through the *.pem rule above.
!/electron/license-public-key.pem

# Explicit safety net for the real (never-committed) secret files.
# These are already caught by the globs above — listed on purpose so a
# reviewer can see at a glance that the sensitive paths are covered.
/.env
/backend/.env
/frontend/.env
/deploy/secrets.env

# ── Local licensing / unlock tooling (admin-only — NEVER public) ────────────
# The Scope Guard token generator plus the master key it signs with are internal
# licensing tools. Publishing them would let anyone mint their own unlock tokens
# and switch the Scope Guard off, which is the exact thing the guard prevents.
/scripts/gen-unlock-token.js
/scripts/.unlock-master-key
/scripts/*.key
/scripts/*.pem
**/.unlock-master-key
**/.vektorsec/

# ── Standalone desktop / DRM ────────────────────────────────────────────────
# electron/license-public-key.pem is the *public* half and must stay tracked:
# electron-builder.yml ships it through extraResources and the backend needs it
# to verify HWID-bound licenses offline. Only private material is ignored here.
/electron/license-private-key.pem
/electron/*private*.pem
/backend/native/build/
/release/

# ── Launcher / run.sh generated state ──────────────────────────────────────
.run.conf
.run-state
docker-compose.override.yml
ssh-keys/
backend/mptest.js

# ── Dependencies ───────────────────────────────────────────────────────────
**/node_modules/
# Production-only dependency trees staged for the installer (scripts/stage-deps.mjs)
.stage/

.pnpm-store/

# ── Build artifacts ────────────────────────────────────────────────────────
**/.next/
**/dist/
/out/
*.tsbuildinfo

# ── Logs, archives & local build output ────────────────────────────────────
*.log
*.zip
*.tar.gz
*.tgz
tsc-*.txt
build-*.txt
run-out.txt
.clineignore

# ── Electron packaging output & staging ─────────────────────────────────────
# release/ holds the installer + the unpacked app (which contains a copy of
# frontend/.env and the bundled runtime); .stage/ is the staged backend/frontend
# tree used to build it. Both are build artifacts, never sources.
/release/
/.stage/
/backend/native/build/
*.node
*.bak

# ── Ad-hoc local scripts (never part of the product) ────────────────────────
/delete_menus.js

# ── Runtime / user data (Docker bind mounts — never versioned) ─────────────
/kali-data/
/kali_data/
**/kali-data/
**/kali_data/
/backend/data/

# ── Local wiki & scratch/temp files (not part of the public repo) ──────────
/wiki/
/backend/_tmp_*

# ── Local screenshots / 2FA QR codes at repo root ──────────────────────────
/admin-login.png
/qr-*.png

# ── Editor / OS ────────────────────────────────────────────────────────────
**/.DS_Store
**/.vscode/
**/.idea/
**/*.swp

# ── Local agent / tooling state ────────────────────────────────────────────
/.cursor/
/.claude/
/.codex-tmp/
/output/

# ── Raw brand artwork (source images stay on disk, only the vectors ship) ──
/logo/banner/
/frontend/public/logo/logo.jpg
