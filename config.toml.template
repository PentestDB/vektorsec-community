# ─── Pentest Copilot — Static Configuration ───────────────────────────
# This file is read once at startup. Changes require a container restart.
# Generated by run.sh — edit manually or re-run: ./run.sh config

[server]
port = 8080
deployment = "LOCAL"                          # LOCAL or PROD
base_url_frontend = "http://localhost:3000"
cors_origins = "http://localhost:3000"

[database]
mongo_uri = "mongodb://mongodb:27017/pentestcopilot"
mongo_database = "pentestcopilot"
redis_url = "redis://redis:6379"

[session]
secret = "thisismysessionsecret!123"
lifetime = 1000

[frontend]
backend_uri = "http://localhost:8080"
deployment = "LOCAL"

[tracing]
enabled = false
public_key = ""
secret_key = ""
base_url = "https://cloud.langfuse.com"
