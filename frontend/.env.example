# ── VektorSec — Frontend environment template (frontend/.env.example) ──────
# 1) Copy to frontend/.env  ->  cp frontend/.env.example frontend/.env
# 2) แก้ค่าให้ตรงกับเครื่อง/เซิร์ฟเวอร์คุณ  (ห้าม commit frontend/.env จริง)
#
# Docker Compose อ่านไฟล์นี้ผ่าน env_file (docker-compose.yml)

# ── Black-Box gateway (server-side only — NEVER exposed to the browser) ──
# ตำแหน่งที่ gateway (frontend/server.js) forward /api, /ws และ /socket.io
# ตอน dev (รัน backend บนเครื่องตัวเอง) ใช้ http://localhost:8081
# ตอน Docker ให้เป็น http://backend:8081 (service name ใน compose)
BACKEND_URI=http://localhost:8081

# ตำแหน่งที่ gateway forward ไฟล์ static noVNC + RFB WebSocket
# (/novnc, /websockify) ของ Browser Agent — ปกติคือ websockify port ของ backend
VNC_ORIGIN_URI=http://localhost:6080

# ── Deployment mode ──
# LOCAL สำหรับ dev, PRODUCTION สำหรับ production
# (DEPLOYMENT=PRODUCTION + ระบุ NEXT_PUBLIC_SITE_URL แล้วเว็บถึงจะถูก index)
NEXT_PUBLIC_DEPLOYMENT=LOCAL
DEPLOYMENT=LOCAL

# Public site URL สำหรับ canonical link / sitemap.xml / robots.txt / Open Graph
# ตอน production ใช้ https://<YOUR_DOMAIN> ; ตอน dev ใช้ http://localhost:3001
# (หน้าเว็บจะ noindex ถ้าไม่ใช่ PRODUCTION)
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# ── Google reCAPTCHA site key (v2 Checkbox) ──
# ปล่อยว่าง = ปิด reCAPTCHA ที่หน้า login/register
# ต้องตรงกับ backend RECAPTCHA_SECRET_KEY
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# ── Scope Guard (security baseline) ──
# UI ของ Scope Guard ล็อกไว้ในบิลด์นี้ (กดปิดจากหน้าแอดมินไม่ได้)
# ค่าเริ่มต้น/ค่าว่าง/ค่าที่พิมพ์ผิด = ล็อกไว้ ; ตั้ง 0 เมื่อทำบิลด์ปลดล็อกให้ลูกค้า:
#   npm run build:unlocked        (เทียบเท่า NEXT_PUBLIC_SCOPE_GUARD_LOCK=0 next build)
# ⚠ ค่านี้ "อย่างเดียวไม่พอ" ที่จะปลดล็อก — ต้องครบทั้ง 3 ข้อพร้อมกัน (fail-closed):
#   1) backend/.env ตั้ง SCOPE_GUARD_LOCK=0
#   2) NEXT_PUBLIC_SCOPE_GUARD_LOCK=0 ทั้งตอน build และใน env ของ backend
#   3) backend/.env มี SCOPE_GUARD_UNLOCK_TOKEN ที่เซ็นโดยผู้ดูแล (+ MASTER_SECRET_KEY
#      หรือ MASTER_UNLOCK_PUBLIC_KEY สำหรับตรวจลายเซ็น)
# ถ้าไม่ครบ ระบบจะยังล็อกไว้และขึ้น log: WARN: Scope Guard unlock attempt failed
# ดูรายละเอียดที่ backend/.env.example และ SECURITY.md
NEXT_PUBLIC_SCOPE_GUARD_LOCK=1

# ── Security headers (CSP, X-Frame-Options ฯลฯ) ──
# ใส่ 0 เมื่ออยากปิด (เช่น มี WAF จัดการเองอยู่แล้ว)
SECURITY_HEADERS_ENABLED=1