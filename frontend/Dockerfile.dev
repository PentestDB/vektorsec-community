# VektorSec frontend — DEVELOPMENT image (hot reload / Fast Refresh)
#
# Runs the custom gateway server (server.js) in Next.js dev mode. Pages/HMR
# recompile on change; /api and /ws are reverse-proxied to BACKEND_URI (the
# backend service in docker-compose.dev.yml).
FROM node:22-bookworm-slim

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
ENV NODE_ENV=development

RUN corepack enable && corepack prepare pnpm@9.15.4 --activate

WORKDIR /app/frontend

# Install dependencies first (better layer caching).
COPY package.json pnpm-lock.yaml* ./
RUN pnpm config set registry https://registry.npmjs.org && pnpm install

# Source is bind-mounted from the host (see docker-compose.dev.yml).
COPY . .

EXPOSE 3001

CMD ["pnpm", "run", "dev"]
