# Specifies the backend server URL (localhost:8080 for local development)
NEXT_PUBLIC_BACKEND_URI=http://localhost:8080
# Indicates the deployment environment (set to LOCAL for development)
NEXT_PUBLIC_DEPLOYMENT=LOCAL
# Google reCAPTCHA site key (v2 Checkbox). Leave empty to disable reCAPTCHA
# on the login/register pages. Must match the backend RECAPTCHA_SECRET_KEY.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
