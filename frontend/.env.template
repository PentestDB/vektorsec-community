# Default settings - These are the basic configurations required for the app to run
# Specifies the backend server URL (localhost:8080 for local development)
NEXT_PUBLIC_BACKEND_URI=http://localhost:8080
# Indicates the deployment environment (set to LOCAL for development)
NEXT_PUBLIC_DEPLOYMENT=LOCAL                   

# Optional settings - These are additional configurations that can be included if needed

# Google Tag Manager - Add your GTM ID if you want to enable tracking
# Empty by default; add your ID here if using GTM
NEXT_PUBLIC_GTM_ID=                           